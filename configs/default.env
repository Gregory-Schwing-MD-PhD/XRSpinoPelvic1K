# =============================================================================
# XRSpinoPelvic1K — default.env
#
# Sourced by every SLURM script so the singularity runtime lives in exactly one
# place. This is the SAME setup as CTSpinoPelvic1K/configs/default.env: on this
# cluster `singularity` is provided by the conda env ~/mambaforge/envs/nextflow
# (there is no /usr/bin/singularity), and the SIF is unpacked to node-local /tmp.
#
# Override at submit time, e.g.:  CTSP1K_ROOT=/path SIF_PATH=/img.sif sbatch ...
# =============================================================================

# ── Container: the SAME image as CTSpinoPelvic1K (containers/ctspinopelvic1k.sif) ──
CTSP1K_ROOT="${CTSP1K_ROOT:-${HOME}/CTSpinoPelvic1K}"
SIF_PATH="${SIF_PATH:-${CTSP1K_ROOT}/containers/ctspinopelvic1k.sif}"

# ── Singularity runtime (verbatim from CTSpinoPelvic1K/configs/default.env) ──
export SINGULARITY_TMPDIR="/tmp/${USER}_job_${SLURM_JOB_ID:-$$}"
export XDG_RUNTIME_DIR="${SINGULARITY_TMPDIR}/runtime"
export NXF_SINGULARITY_CACHEDIR="${HOME}/singularity_cache"
mkdir -p "${SINGULARITY_TMPDIR}" "${XDG_RUNTIME_DIR}" "${NXF_SINGULARITY_CACHEDIR}"
trap 'rm -rf "${SINGULARITY_TMPDIR}"' EXIT
export CONDA_PREFIX="${HOME}/mambaforge/envs/nextflow"
export PATH="${CONDA_PREFIX}/bin:${PATH}"
unset JAVA_HOME; which singularity
export NXF_SINGULARITY_HOME_MOUNT=true
unset LD_LIBRARY_PATH PYTHONPATH R_LIBS R_LIBS_USER R_LIBS_SITE
