// XRSpinoPelvic1K -- Nextflow profiles.
//
// The container is the SAME .sif the SLURM scripts use, so a pipeline run and a
// hand-submitted sbatch cannot diverge in their environment.

manifest {
    name        = 'XRSpinoPelvic1K'
    description = 'Unified spinopelvic landmark pipeline (DRR hip + BUU corners)'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

params {
    container = "${projectDir}/../containers/xrspinopelvic.sif"
}

profiles {

    // local CPU, for wiring checks on a few cases
    standard {
        process.executor = 'local'
        docker.enabled   = false
    }

    slurm {
        process {
            executor      = 'slurm'
            scratch       = true
            errorStrategy = { task.exitStatus in [140,143,137,104,134,139] ? 'retry' : 'finish' }
            maxRetries    = 2

            withLabel: cpu {
                queue     = 'primary'
                cpus      = 4
                memory    = '32 GB'
                time      = '4h'
            }
            withLabel: gpu {
                queue     = 'gpu'
                cpus      = 12
                memory    = '120 GB'
                time      = '24h'
                clusterOptions = '--gres=gpu:1 --requeue'
            }
        }
        singularity {
            enabled    = true
            autoMounts = true
            runOptions = '--nv'
            cacheDir   = "${System.getenv('SCRATCH') ?: '/tmp'}/singularity_cache"
        }
        process.container = params.container
    }

    docker {
        process.executor = 'local'
        docker.enabled   = true
        process.container = 'gregoryschwingmdphd/xrspinopelvic:latest'
    }
}

// A run that cannot be reproduced is not a result.
timeline { enabled = true; file = "${params.outdir ?: 'results'}/_report/timeline.html" }
report   { enabled = true; file = "${params.outdir ?: 'results'}/_report/report.html" }
trace    { enabled = true; file = "${params.outdir ?: 'results'}/_report/trace.txt" }
